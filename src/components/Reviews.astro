---
import { reviews } from '../data/site';
---

<section id="reviews" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 class="text-center font-display text-3xl font-bold uppercase sm:text-4xl">Отзывы</h2>

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {reviews.map((r) => (
      <li class="flex flex-col rounded-3xl border border-line bg-surface p-6 sm:p-8">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="text-primary" aria-hidden="true">
          <path d="M4 18v-5c0-4 2-7 6-8l1 2c-2 1-3 2.5-3 5h3v6zm9 0v-5c0-4 2-7 6-8l1 2c-2 1-3 2.5-3 5h3v6z" />
        </svg>
        <blockquote class="mt-4 flex-1 leading-relaxed">{r.text}</blockquote>
        <p class="mt-6 font-semibold text-primary">{r.name}</p>
      </li>
    ))}
  </ul>
</section>
