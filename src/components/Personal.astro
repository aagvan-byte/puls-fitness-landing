---
import { Image } from 'astro:assets';
import trainerImg from '../assets/trainer.jpg';

const points = [
  'Программа под вашу цель: похудеть, набрать форму или вернуться после травмы',
  'Замер состава тела в начале и каждый месяц - прогресс видно в цифрах',
  'План питания без жёстких диет и запрета любимой еды',
  'Связь с тренером в чате между тренировками',
];
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
  <div class="relative mx-auto w-full max-w-md">
    <Image
      src={trainerImg}
      alt="Тренер студии в зале, руки скрещены на груди"
      widths={[400, 700, 1000]}
      sizes="(min-width: 768px) 40vw, 90vw"
      class="aspect-[4/5] w-full rounded-3xl object-cover"
    />
    <div class="absolute -right-2 -bottom-5 rounded-2xl bg-primary px-5 py-4 text-on-primary shadow-xl sm:-right-6">
      <p class="font-display text-2xl font-bold">−7 кг</p>
      <p class="text-sm font-semibold">в среднем за 3 месяца</p>
    </div>
  </div>

  <div>
    <p class="text-sm font-semibold tracking-widest text-primary uppercase">Персональные тренировки</p>
    <h2 class="mt-3 font-display text-3xl font-bold uppercase sm:text-4xl">Тренер, который ведёт к результату</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Все тренеры с профильным образованием и опытом от 5 лет. Подберём того, кто подходит вам по цели и характеру.
    </p>
    <ul class="mt-8 space-y-4">
      {points.map((p) => (
        <li class="flex gap-3">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
          </span>
          <span class="leading-relaxed">{p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
