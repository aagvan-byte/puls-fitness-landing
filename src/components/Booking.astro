---
import { directions } from '../data/site';

// Демо-форма: заявка никуда не отправляется, показывается сообщение об успехе.
// Для реального клиента подключим отправку в Telegram или на почту.
const field =
  'mt-2 block w-full rounded-xl border border-line bg-bg px-4 py-3 text-base text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30';
---

<section id="booking" class="relative isolate overflow-hidden border-y border-line bg-surface">
  <div class="absolute -top-40 -right-40 -z-10 h-96 w-96 rounded-full bg-primary/15 blur-3xl" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold uppercase sm:text-4xl">
        Первая тренировка <span class="text-primary">бесплатно</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Оставьте телефон - перезвоним, ответим на вопросы и подберём удобное время. Займёт 2 минуты.
      </p>
      <ul class="mt-8 space-y-3">
        {['Знакомство с тренером и залом', 'Замер состава тела в подарок', 'Подбор направления под вашу цель'].map((t) => (
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <form id="booking-form" class="rounded-3xl border border-line bg-raised p-6 sm:p-8" novalidate>
        <div class="grid gap-5">
          <label>
            <span class="font-medium">Имя</span>
            <input name="name" type="text" required autocomplete="given-name" class={field} />
          </label>
          <label>
            <span class="font-medium">Телефон</span>
            <input name="phone" type="tel" required autocomplete="tel" placeholder="+7 (___) ___-__-__" pattern="[\d\s\(\)\+\-]{10,}" class={field} />
          </label>
          <label>
            <span class="font-medium">Направление</span>
            <select name="direction" class={field}>
              <option value="">Пока не знаю</option>
              {directions.map((d) => <option>{d.title}</option>)}
            </select>
          </label>
          <!-- Ловушка для спам-ботов: человек это поле не видит, бот заполняет -->
          <label class="absolute -left-[9999px]" aria-hidden="true">
            Сайт
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <p id="form-error" class="mt-4 hidden text-sm font-medium text-red-400" role="alert">
          Пожалуйста, укажите имя и телефон.
        </p>

        <button
          type="submit"
          class="mt-6 w-full rounded-full bg-primary px-7 py-3.5 font-bold text-on-primary transition-colors hover:bg-primary-hover"
        >
          Записаться на пробную
        </button>
        <p class="mt-3 text-center text-xs text-muted">Нажимая кнопку, вы соглашаетесь на обработку персональных данных.</p>
      </form>

      <div id="form-success" class="hidden rounded-3xl border border-line bg-raised p-8 text-center" role="status">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary text-on-primary">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
        </div>
        <h3 class="mt-4 text-xl font-semibold">Заявка отправлена!</h3>
        <p class="mt-2 text-muted">Перезвоним в течение 15 минут.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const error = document.getElementById('form-error')!;
  const success = document.getElementById('form-success')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // Бот заполнил скрытое поле - молча ничего не делаем
    if ((form.elements.namedItem('website') as HTMLInputElement).value) return;
    if (!form.checkValidity()) {
      error.classList.remove('hidden');
      (form.querySelector(':invalid') as HTMLElement | null)?.focus();
      return;
    }
    error.classList.add('hidden');
    form.classList.add('hidden');
    success.classList.remove('hidden');
  });
</script>
