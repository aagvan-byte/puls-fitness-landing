---
import { faq } from '../data/site';
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
  <h2 class="text-center font-display text-3xl font-bold sm:text-4xl">Частые вопросы</h2>

  <div class="mt-10 space-y-3">
    {faq.map((item) => (
      <details class="group rounded-2xl border border-line bg-surface open:shadow-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold sm:px-6 [&::-webkit-details-marker]:hidden">
          {item.q}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-primary transition-transform group-open:rotate-45" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </summary>
        <p class="px-5 pb-5 leading-relaxed text-muted sm:px-6">{item.a}</p>
      </details>
    ))}
  </div>
</section>
