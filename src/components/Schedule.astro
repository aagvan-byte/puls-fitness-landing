---
import { schedule, days } from '../data/site';
---

<section id="schedule" class="border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="font-display text-3xl font-bold uppercase sm:text-4xl">Расписание</h2>
    <p class="mt-4 text-muted">Тренировка длится 55 минут. На телефоне таблицу можно листать вбок.</p>

    <!-- На узком экране таблица прокручивается внутри своего блока, страница не «едет» -->
    <div class="mt-10 overflow-x-auto rounded-2xl border border-line" tabindex="0" role="region" aria-label="Расписание тренировок">
      <table class="w-full min-w-[760px] border-collapse text-sm">
        <thead>
          <tr class="bg-raised">
            <th scope="col" class="w-20 px-4 py-3 text-left font-semibold text-muted">Время</th>
            {days.map((d) => <th scope="col" class="px-3 py-3 text-left font-semibold">{d}</th>)}
          </tr>
        </thead>
        <tbody>
          {schedule.map((row) => (
            <tr class="border-t border-line">
              <th scope="row" class="px-4 py-4 text-left font-display font-bold text-primary">{row.time}</th>
              {row.items.map((item) => (
                <td class="px-2 py-2">
                  {item && <span class="block rounded-lg bg-raised px-3 py-2 font-medium">{item}</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
