---
import { site } from '../data/site';

const links = [
  { href: '#directions', label: 'Направления' },
  { href: '#schedule', label: 'Расписание' },
  { href: '#prices', label: 'Абонементы' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#" class="flex items-center gap-2" aria-label={`${site.name} - на главную`}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="font-display text-lg font-bold tracking-wide uppercase">{site.name}</span>
    </a>

    <nav class="hidden lg:block" aria-label="Основная навигация">
      <ul class="flex items-center gap-7 text-[15px] font-medium text-muted">
        {links.map((l) => (
          <li><a href={l.href} class="transition-colors hover:text-primary">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={site.phoneHref} class="font-semibold whitespace-nowrap hover:text-primary">{site.phone}</a>
      <a
        href="#booking"
        class="rounded-full bg-primary px-5 py-2.5 text-sm font-bold whitespace-nowrap text-on-primary transition-colors hover:bg-primary-hover"
      >
        Пробная бесплатно
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-lg text-ink lg:hidden"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-bg lg:hidden" aria-label="Мобильная навигация">
    <ul class="flex flex-col px-4 py-2">
      {links.map((l) => (
        <li><a href={l.href} class="block py-3 text-base font-medium">{l.label}</a></li>
      ))}
      <li><a href={site.phoneHref} class="block py-3 text-base font-semibold text-primary">{site.phone}</a></li>
      <li class="py-3">
        <a href="#booking" class="block rounded-full bg-primary px-5 py-3 text-center font-bold text-on-primary">
          Пробная бесплатно
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('mobile-nav')!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
  };

  toggle.addEventListener('click', () => setOpen(nav.classList.contains('hidden')));
  // Закрываем меню после перехода по ссылке
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
